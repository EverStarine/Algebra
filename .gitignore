!*/
!/.gitignore
!/.gitattributes
!/README.md
!/Book[1-5].pdf
!/Book[1-5]/**/*.tex
!/Shared/*.tex
!/Shared/References.bib
!/Shared/algebra.ist
!/build.ps1
!/scripts/Build-Book.ps1
!/Book[1-5]/build-Book[1-5].ps1
!/Book[1-5]/build-Book[1-5].bat
# Working records, writing standards, audits and private materials stay local.
